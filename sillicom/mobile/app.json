{
  "expo": {
    "name": "Sillicom",
    "slug": "sillicom",
    "version": "1.0.0",
    "scheme": "sillicom",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.sillicom.app",
      "versionCode": 1,
      "adaptiveIcon": {"foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#C8553D"},
      "permissions": ["android.permission.INTERNET", "android.permission.VIBRATE", "android.permission.POST_NOTIFICATIONS", "android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO", "android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      "expo-router", "expo-font",
      ["expo-calendar", {"calendarPermission": "Add an event you choose to your calendar."}],
      ["expo-notifications", {"icon": "./assets/notification-icon.png", "color": "#C8553D"}],
      ["expo-splash-screen", {"image": "./assets/splash.png", "imageWidth": 180, "backgroundColor": "#F6EFE4", "dark": {"image": "./assets/splash.png", "backgroundColor": "#0D0F14"}}],
      ["expo-build-properties", {"android": {"usesCleartextTraffic": false}}]
    ],
    "experiments": {"typedRoutes": true}
  }
}
